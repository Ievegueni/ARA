# Base de dados (Postgres + pgvector)
DATABASE_URL="postgresql://ara:ara@localhost:5432/ara"

# Servidor
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=mude-isto-para-um-segredo-longo-e-aleatorio

# Modo de funcionamento
#   false = pesquisa por palavras-chave no manual (sem IA, sem serviços externos) — modo atual
#   true  = pesquisa semântica (Voyage) + resposta escrita pelo Claude
AI_ENABLED=false

# Só necessários com AI_ENABLED=true
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4

# Pesquisa
RETRIEVAL_TOP_K=6
# Sem IA: fração mínima dos termos da pergunta que o excerto tem de conter; nº de excertos por resposta
KEYWORD_MIN_COVERAGE=0.3
KEYWORD_ANSWER_CHUNKS=3
# Com IA: similaridade mínima
RETRIEVAL_MIN_SCORE=0.35
