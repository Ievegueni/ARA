# Base de dados (Postgres + pgvector)
DATABASE_URL="postgresql://ara:ara@localhost:5432/ara"

# Servidor
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=mude-isto-para-um-segredo-longo-e-aleatorio

# Claude API (LLM)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Embeddings: "voyage" (produção) | "local" (apenas desenvolvimento, sem qualidade semântica)
