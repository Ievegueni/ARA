# Base de dados (Postgres + pgvector)
DATABASE_URL="postgresql://ara:ara@localhost:5432/ara"

# Servidor
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=mude-isto-para-um-segredo-longo-e-aleatorio

# IA: liga-se/desliga-se na interface (administrador → botão "IA" no cabeçalho), sem reiniciar.
# AI_ENABLED é só o estado inicial, antes de alguém usar o botão.
AI_ENABLED=false

# Chaves API — ficam só aqui, nunca na base de dados nem no navegador. Depois de alterar: pm2 restart ara-api
# Claude: obrigatória para ligar a IA (o Claude escreve a resposta).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Voyage: opcional. Sem ela, a pesquisa continua por palavras-chave; com ela, passa a ser por significado.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4

# Pesquisa
RETRIEVAL_TOP_K=6
# Sem IA: fração mínima dos termos da pergunta que o excerto tem de conter; nº de excertos por resposta
KEYWORD_MIN_COVERAGE=0.3
KEYWORD_ANSWER_CHUNKS=3
# Com IA: similaridade mínima
RETRIEVAL_MIN_SCORE=0.35

# PDF originais dos manuais ("Ver página no manual", com imagens e esquemas). Incluir nos backups.
DOCUMENT_DIR=./storage/manuals

# Vídeos
# Pasta onde ficam guardados (incluir nos backups). Caminho absoluto recomendado no VPS.
VIDEO_DIR=./storage/videos
# Tamanho máximo por vídeo (MB); o Nginx (deploy/nginx.conf) aceita até 550 MB
MAX_VIDEO_MB=500
# Vídeos sugeridos por resposta no chat
VIDEO_ANSWER_COUNT=2
